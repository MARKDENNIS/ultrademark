<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_estate_property_form_website" model="ir.ui.view">
    <field name="name">estate.property.form.website</field>
    <field name="model">estate.property</field>
    <field name="inherit_id" ref="realestate_core.view_estate_property_form"/>
    <field name="arch" type="xml">
      <!-- add a new Website tab -->
      <xpath expr="//form/sheet/notebook" position="inside">
        <page string="Website">
          <group>
            <group>
              <field name="website_published"/>
              <field name="canonical_url"/>
            </group>
            <group>
              <field name="website_meta_title"/>
              <field name="website_meta_description"/>
              <field name="website_meta_keywords"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
