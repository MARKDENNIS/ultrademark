<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="properties" name="Property Listings">
    <t t-call="website.layout">
      <div class="container my-5">

        <div class="text-center mb-5">
            <h1 class="fw-bold mb-3">Find Your Next Property</h1>
            <p class="text-muted">Explore our exclusive collection of homes for sale and rent.</p>
        </div>

        <div class="card shadow-sm border-0 rounded-4 mb-5 p-2 bg-white">

          <form id="seo_property_search" class="row g-2 align-items-center mb-0" onsubmit="submitCleanSearch(event)">

            <div class="col-12 col-lg-4">
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-transparent border-0 text-muted">
                    <i class="fa fa-search"/>
                </span>
                <input class="form-control border-0 shadow-none bg-transparent ps-0" type="search" name="search"
                       t-att-value="q.get('search', '') if q else request.params.get('search', '')" placeholder="Search city, neighborhood, or name..."/>
              </div>
            </div>

            <div class="col-6 col-lg-2 border-start-lg">
              <select class="form-select border-0 shadow-none bg-transparent cursor-pointer" name="city">
                <option value="">Any City</option>
                <t t-foreach="cities" t-as="c">
                  <t t-set="city_slug" t-value="c.name.lower().replace(' ', '-')"/>
                  <option t-att-value="city_slug"
                          t-att-selected="(q and q.get('city') == city_slug) or request.params.get('city') == city_slug">
                    <t t-esc="c.name"/>
                  </option>
                </t>
              </select>
            </div>

            <div class="col-6 col-lg-2 border-start-lg">
              <select class="form-select border-0 shadow-none bg-transparent cursor-pointer" name="property_type">
                <option value="">Any Type</option>
                <t t-foreach="property_types" t-as="ptype">
                  <t t-set="type_slug" t-value="ptype.name.lower().replace(' ', '-')"/>
                  <option t-att-value="type_slug"
                          t-att-selected="(q and q.get('property_type') == type_slug) or request.params.get('property_type') == type_slug">
                    <t t-esc="ptype.name"/>
                  </option>
                </t>
              </select>
            </div>

            <div class="col-12 col-lg-2 border-start-lg">
              <select class="form-select border-0 shadow-none bg-transparent cursor-pointer" name="tenure">
                <option value="">Buy or Rent?</option>
                <option value="sale" t-att-selected="(q and q.get('tenure') == 'sale') or request.params.get('tenure') == 'sale'">For Sale</option>
                <option value="rent" t-att-selected="(q and q.get('tenure') == 'rent') or request.params.get('tenure') == 'rent'">For Rent</option>
              </select>
            </div>

            <div class="col-12 col-lg-2">
              <button class="btn btn-primary btn-lg w-100 rounded-3 fw-bold" type="submit">Search</button>
            </div>
          </form>
<script>
          // <![CDATA[
            function submitCleanSearch(event) {
                event.preventDefault();
                var form = event.target;
                var url = '/properties';

                var tenure = form.tenure.value;
                var city = form.city.value;
                var ptype = form.property_type.value;
                var search = form.search.value;

                // 1. Build the clean path using 'any' as a fallback for missing middle segments
                if (tenure || city || ptype) {
                    url += '/' + (tenure || 'any');
                    if (city || ptype) {
                        url += '/' + (city || 'any');
                        if (ptype) {
                            url += '/' + ptype;
                        }
                    }
                }

                // 2. Build remaining query parameter for the text search
                var params = [];
                if (search) params.push('search=' + encodeURIComponent(search));

                if (params.length > 0) {
                    url += '?' + params.join('&');
                }

                // Redirect to the beautifully formatted SEO URL
                window.location.href = url;
            }
          // ]]>
          </script>

        </div>

        <div class="row">
          <section class="col-lg-12">

            <t t-if="not properties">
              <div class="text-center py-5">
                <i class="fa fa-home fa-4x text-muted mb-3 opacity-50"/>
                <h3 class="text-muted fw-bold">No properties found</h3>
                <p class="text-muted">Try adjusting your filters or searching a different area.</p>
                <a href="/properties" class="btn btn-outline-primary mt-2 rounded-pill">Clear all filters</a>
              </div>
            </t>

            <t t-else="">
              <div class="row g-4">
                <t t-foreach="properties" t-as="p">
                  <t t-call="realestate_website.property_card">
                    <t t-set="prop" t-value="p"/>
                  </t>
                </t>
              </div>
            </t>
          </section>

          <t t-if="properties">
              <section class="d-flex justify-content-center mt-5">
                <t t-call="website.pager"/>
              </section>
          </t>
        </div>
      </div>
    </t>
  </template>
</odoo>