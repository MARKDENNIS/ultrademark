        <div class="row g-5">
          <div class="col-lg-8">

           <div class="position-relative rounded-4 overflow-hidden shadow-sm mb-3 bg-light" style="height: 500px;">
  <t t-if="property.gallery_ids">
    <t t-set="gals" t-value="property.gallery_ids"/>
    <img id="mainImage"
         t-att-src="'/web/image/estate.property.image/%s/image_1920' % gals[0].id"
         t-att-alt="property.name"
         class="w-100 h-100 object-fit-cover transition-fade"/>

   <button class="position-absolute start-0 translate-middle-y ms-3 rounded-circle shadow-sm border-0 d-flex align-items-center justify-content-center"
        style="width: 48px; height: 48px; top: 50%; z-index: 12; cursor: pointer; transition: all 0.2s; background: rgba(255, 255, 255, 0.15);"
        type="button"
        onclick="navigateGallery(-1)">
    <i class="fa fa-chevron-left text-dark"> </i>
</button>

<button class="position-absolute end-0 translate-middle-y me-3 rounded-circle shadow-sm border-0 d-flex align-items-center justify-content-center"
        style="width: 48px; height: 48px; top: 50%; z-index: 12; cursor: pointer; transition: all 0.2s; background: rgba(255, 255, 255, 0.15);"
        type="button"
        onclick="navigateGallery(1)">
    <i class="fa fa-chevron-right text-dark"></i>
</button>
  </t>
  <t t-else="">
    <img id="mainImage"
         src="/web/static/src/img/placeholder.png"
         alt="No image"
         class="w-100 h-100 object-fit-cover opacity-50"/>
  </t>

  <div class="position-absolute top-0 start-0 m-3 z-index-1">
  <span class="badge rounded-pill px-3 py-2 shadow-sm border border-success"
        style="background-color: rgba(25, 135, 84, 0.15); color: #198754; backdrop-filter: blur(4px);">
    <i class="fa fa-check-circle me-1"/> VERIFIED
  </span>
</div>
</div>
<div class="re-gallery-strip d-flex gap-2 overflow-auto pb-2 mb-5">
  <t t-if="property.gallery_ids">
    <t t-foreach="property.gallery_ids" t-as="img" t-key="img.id">
      <img
        t-att-src="'/web/image/estate.property.image/%s/image_1920' % img.id"
        t-att-alt="img.caption or property.name"
        class="re-thumbnail rounded-3 shadow-sm object-fit-cover cursor-pointer"
        style="width: 120px; height: 80px; transition: border 0.2s;"
        t-att-data-full-src="'/web/image/estate.property.image/%s/image_1920' % img.id"
        t-att-data-index="img_index"
        onclick="setGalleryIndex(parseInt(this.getAttribute('data-index')));"
      />
    </t>
  </t>
</div>

<script>
// <![CDATA[
var currentGalleryIndex = 0;

function updateGalleryUI() {
    // Re-fetch thumbnails every time to ensure we have the correct count
    var thumbnails = document.querySelectorAll('.re-thumbnail');
    if (thumbnails.length === 0) return;

    // Safety: If index is out of bounds, reset to 0
    if (currentGalleryIndex >= thumbnails.length || currentGalleryIndex < 0) {
        currentGalleryIndex = 0;
    }

    var targetThumb = thumbnails[currentGalleryIndex];
    if (targetThumb) {
        // Update Main Image
        var mainImg = document.getElementById('mainImage');
        if (mainImg) {
            mainImg.src = targetThumb.getAttribute('data-full-src');
        }

        // Update active border classes
        thumbnails.forEach(function(thumb, idx) {
            if (idx === currentGalleryIndex) {
                thumb.classList.add('border', 'border-primary', 'border-2');
                thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            } else {
                thumb.classList.remove('border', 'border-primary', 'border-2');
            }
        });
    }
}

function navigateGallery(direction) {
    var thumbnails = document.querySelectorAll('.re-thumbnail');
    if (thumbnails.length === 0) return;

    // Cycle index correctly
    currentGalleryIndex = (currentGalleryIndex + direction + thumbnails.length) % thumbnails.length;
    updateGalleryUI();
}

function setGalleryIndex(index) {
    currentGalleryIndex = index;
    updateGalleryUI();
}

// Mobile Swipe Touch Gesture Processing
document.addEventListener('DOMContentLoaded', function() {
    var mainImg = document.getElementById('mainImage');
    var mainImgContainer = mainImg ? mainImg.parentElement : null;
    if (mainImgContainer) {
        var touchStartX = 0;
        var touchEndX = 0;

        mainImgContainer.addEventListener('touchstart', function(e) {
            touchStartX = e.changedTouches[0].screenX;
        }, {passive: true});

        mainImgContainer.addEventListener('touchend', function(e) {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        }, {passive: true});

        function handleSwipe() {
            var threshold = 40;
            if (touchStartX - touchEndX > threshold) {
                navigateGallery(1);  // Swiped left
            } else if (touchEndX - touchStartX > threshold) {
                navigateGallery(-1); // Swiped right
            }
        }
    }
});
// ]]>
</script>

