            <div class="text-secondary lh-lg mb-5" style="font-size: 1.05rem;">
              <t t-call="realestate_website.property_description">
                <t t-set="property" t-value="property"/>
              </t>
            </div>

            <t t-if="property.attribute_line_ids">
              <hr class="mb-5 border-light"/>
              <h4 class="fw-bold mb-4">Features &amp; Amenities</h4>
              <div class="row">
                <t t-foreach="property.attribute_line_ids" t-as="al">
                  <div class="col-md-6 mb-3">
                    <div class="d-flex align-items-center">
                      <i class="fa fa-check text-success me-2"/>
                      <span class="text-secondary me-1"><t t-esc="al.attribute_id.name"/>:</span>
                      <strong class="text-dark">
                        <t t-if="al.value_id" t-esc="al.value_id.name"/>
                        <t t-if="al.value_ids" t-esc="', '.join(al.value_ids.mapped('name'))"/>
                      </strong>
                    </div>
                  </div>
                </t>
              </div>
            </t>
          </div>

          <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 p-4 sticky-top" style="top: 100px; z-index: 10;">

              <div class="mb-4 text-center">
                <div class="text-muted small text-uppercase fw-bold tracking-wide mb-1">
                    <t t-esc="property.tenure == 'sale' and 'Asking Price' or 'Monthly Rent'"/>
                </div>
                <div class="display-6 fw-bolder text-primary">
                  <t t-if="property.tenure == 'sale'">
                    <span t-att-title="property._format_compact_price()" t-esc="property._format_compact_price()"/>
                  </t>
                  <t t-if="property.tenure == 'rent'">
                    <span t-att-title="property._format_compact_rent()" t-esc="property._format_compact_rent()"/>
                  </t>
                </div>
                <div class="mt-2 pt-2 border-top small text-muted d-flex justify-content-between">
                    <span>Available: <strong class="text-dark"><t t-esc="property.availability_date or 'Immediately'"/></strong></span>
                    <!-- FIX APPLIED HERE: Added replace and title formatting -->
                    <span>Status: <strong class="text-dark">
                        <t t-esc="property.furnishing.replace('_', ' ').title() if property.furnishing else 'Unfurnished'"/>
                    </strong></span>
                </div>
              </div>

              <h5 class="fw-bold mb-3">Interested in this property?</h5>
              <form t-att-action="'/property/inquiry'" method="post" class="d-grid gap-3">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="property_id" t-att-value="property.id"/>

                <div class="form-floating">
                    <input required="required" type="text" class="form-control bg-light border-0" id="name" name="name" placeholder="Your Name"/>
                    <label for="name" class="text-muted">Your Name</label>
                </div>
                <div class="form-floating">
                    <input required="required" type="email" class="form-control bg-light border-0" id="email" name="email" placeholder="Email Address"/>
                    <label for="email" class="text-muted">Email Address</label>
                </div>
                <div class="form-floating">
                    <input type="tel" class="form-control bg-light border-0" id="phone" name="phone" placeholder="Phone Number"/>
                    <label for="phone" class="text-muted">Phone Number</label>
                </div>
                <div class="form-floating">
                    <textarea class="form-control bg-light border-0" id="message" name="message" placeholder="Message" style="height: 100px"></textarea>
                    <label for="message" class="text-muted">Message (Optional)</label>
                </div>

                <button class="btn btn-primary btn-lg rounded-pill fw-bold mt-2" type="submit">
                    Request Details
                </button>
              </form>
              <t t-if="request.params.get('thanks')">
                <div class="alert alert-success rounded-4 mt-3 mb-0 text-center border-0 shadow-sm">
                  <i class="fa fa-check-circle me-1"/> Thanks! We'll contact you shortly.
                </div>
              </t>
            </div>
          </div>

        </div> <div class="mt-6 pt-5">
