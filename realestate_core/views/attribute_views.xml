<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_estate_attribute_list" model="ir.ui.view">
    <field name="name">estate.property.attribute.list</field>
    <field name="model">estate.property.attribute</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="attr_type"/>
      </list>
    </field>
  </record>

  <record id="view_estate_attribute_form" model="ir.ui.view">
    <field name="name">estate.property.attribute.form</field>
    <field name="model">estate.property.attribute</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="attr_type"/>
            <field name="show_in_website_filter"/>
          </group>
          <notebook>
            <page string="Values">
              <field name="value_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="active"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_estate_attribute" model="ir.actions.act_window">
    <field name="name">Attributes</field>
    <field name="res_model">estate.property.attribute</field>
    <field name="view_mode">list,form</field>
  </record>

    <menuitem id="menu_realestate_attributes" name="Attributes" parent="menu_realestate_config" action="action_estate_attribute"/>
</odoo>
