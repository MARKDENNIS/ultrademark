<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Tree -->
  <record id="view_estate_property_badge_tree" model="ir.ui.view">
    <field name="name">estate.property.badge.tree</field>
    <field name="model">estate.property.badge</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="color"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <!-- Form -->
  <record id="view_estate_property_badge_form" model="ir.ui.view">
    <field name="name">estate.property.badge.form</field>
    <field name="model">estate.property.badge</field>
    <field name="arch" type="xml">
      <form string="Property Badge">
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="color"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_estate_property_badge" model="ir.actions.act_window">
    <field name="name">Badges</field>
    <field name="res_model">estate.property.badge</field>
    <field name="view_mode">list,form</field>
  </record>

      <!-- Menu -->
  <menuitem id="menu_realestate_badges"
            name="Badges"
            parent="realestate_core.menu_realestate_config"
            sequence="35"
            action="action_estate_property_badge"/>
</odoo>
