<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- City -->
  <record id="view_estate_city_list" model="ir.ui.view">
    <field name="name">estate.city.list</field>
    <field name="model">estate.city</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="state_id"/>
        <field name="country_id"/>
        <field name="zip_prefix"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_estate_city_form" model="ir.ui.view">
    <field name="name">estate.city.form</field>
    <field name="model">estate.city</field>
    <field name="arch" type="xml">
      <form string="City">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="zip_prefix"/>
              <field name="active"/>
            </group>
            <group>
              <field name="country_id"/>
              <field name="state_id" domain="[('country_id','=',country_id)]"/>
            </group>
          </group>
          <notebook>
            <page string="Areas">
              <field name="area_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="active"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Area -->
  <record id="view_estate_area_list" model="ir.ui.view">
    <field name="name">estate.area.list</field>
    <field name="model">estate.area</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="city_id"/>
        <field name="state_id"/>
        <field name="country_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_estate_area_form" model="ir.ui.view">
    <field name="name">estate.area.form</field>
    <field name="model">estate.area</field>
    <field name="arch" type="xml">
      <form string="Area / Locality">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="active"/>
            </group>
            <group>
              <field name="city_id"/>
              <field name="state_id" readonly="1"/>
              <field name="country_id" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

    <!-- Actions -->
  <record id="action_estate_city" model="ir.actions.act_window">
    <field name="name">Cities</field>
    <field name="res_model">estate.city</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_estate_area" model="ir.actions.act_window">
    <field name="name">Areas / Localities</field>
    <field name="res_model">estate.area</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menus (under your existing Config menu) -->
  <menuitem id="menu_estate_cities" name="Cities"
            parent="menu_realestate_config" action="action_estate_city" sequence="23"/>
  <menuitem id="menu_estate_areas" name="Areas"
            parent="menu_realestate_config" action="action_estate_area" sequence="24"/>

</odoo>
