<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_estate_property_list" model="ir.ui.view">
    <field name="name">estate.property.list</field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
      <list>
        <field name="ref"/>
        <field name="name"/>
        <field name="type_id"/>
        <field name="tenure"/>
        <field name="price"/>
        <field name="rent_price"/>
        <field name="bedrooms"/>
        <field name="bathrooms"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_estate_property_form" model="ir.ui.view">
    <field name="name">estate.property.form</field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
      <form string="Property">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_publish" type="object" class="oe_stat_button" icon="fa-globe"
                    invisible="state == 'published'"/>
            <button name="action_mark_sold" type="object" class="oe_stat_button" icon="fa-check"/>
            <button name="action_archive" type="object" class="oe_stat_button" icon="fa-archive"/>
          </div>

          <group>
            <group>
              <field name="name"/>
              <field name="ref" readonly="1"/>
              <field name="type_id"/>
              <field name="state"/>
              <field name="priority"/>
            </group>
            <group>
              <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
            </group>
          </group>

          <notebook>
            <page string="Details">
              <group colspan="2">
                <group>
                  <field name="tenure"/>
                  <field name="price" invisible="tenure != 'sale'"/>
                  <field name="rent_price" invisible="tenure != 'rent'"/>
                  <field name="currency_id"/>
                  <field name="badge_ids" widget="many2many_tags" placeholder="Add badges (e.g. New, Hot, Verified)"/>
                </group>
                <group>
                  <field name="bedrooms"/>
                  <field name="bathrooms"/>
                  <field name="parking_spaces"/>
                  <field name="furnishing"/>
                </group>
              </group>
              <group colspan="2">
                <group>
                  <field name="area_built"/>
                  <field name="area_total"/>
                  <field name="year_built"/>
                  <field name="floor_no"/>
                  <field name="total_floors"/>
                </group>
                <group>
                  <field name="availability_date"/>
                </group>
              </group>
            </page>

            <page string="Location">
              <group>
                <group>
                  <field name="street"/>
                  <field name="city_id" options="{'no_open': True}"/>
                  <field name="area_id" options="{'no_open': True}" domain="[('city_id','=',city_id)]"/>
                  <field name="zip"/>
                </group>
                <group>
                  <field name="state_id"/>
                  <field name="country_id"/>
                  <field name="latitude"/>
                  <field name="longitude"/>
                </group>
              </group>
            </page>

            <page string="Description">
              <group>
                <field name="short_description"/>
                <field name="description"/>
              </group>
            </page>

            <page string="Attributes">
              <field name="attribute_line_ids">
                <list editable="bottom">
                  <field name="attribute_id"/>
                  <field name="attr_type"/>
                  <field name="value_id"
                         domain="[('attribute_id','=',attribute_id)]"
                         readonly="attr_type != 'select'"/>
                  <field name="value_ids" widget="many2many_tags"
                         domain="[('attribute_id','=',attribute_id)]"
                         readonly="attr_type != 'multi'"/>
                </list>
              </field>
            </page>

            <page string="Leads" name="leads">
              <button name="action_new_lead" type="object" string="Create Lead" class="oe_highlight"/>
              <field name="lead_ids">
                <list>
                  <field name="name"/>
                  <field name="partner_id"/>
                  <field name="stage_id"/>
                  <field name="probability"/>
                </list>
              </field>
            </page>


            <page string="Gallery">
              <field name="gallery_ids" context="{'default_property_id': id}">
                <!--<kanban class="o_kanban_no_columns o_res_images_kanban" default_group_by="">
                  <templates>
                    <t t-name="kanban-box">
                      <div class="o_image_kanban" style="width: 120px;">
                        <div>
                          <field name="image_1920" widget="image" class="o_kanban_image_fill"
                                 options="{'size': [120, 120]}"/>
                        </div>
                        <div class="o_kanban_record_bottom small mt-1">
                          <field name="caption"/>
                          <div class="d-flex justify-content-between align-items-center mt-1">
                            <field name="is_cover"/>
                            <field name="sequence"/>
                          </div>
                        </div>
                      </div>
                    </t>
                  </templates>
                </kanban>-->
              </field>
            </page>


            <!-- Specifications -->
            <page string="Specifications">
              <field name="spec_group_ids">
                <list>
                  <field name="sequence"/>
                  <field name="name"/>
                </list>
              </field>
            </page>

            <!-- Plans -->
            <page string="Plans">
              <field name="plan_ids">
                <list>
                  <field name="sequence"/>
                  <field name="name"/>
                  <field name="category_id"/>
                  <field name="cover_image_1920" widget="image"/>
                </list>
              </field>
            </page>

            <page string="Marketing">
              <group>
                <group>
                  <field name="listed_by"/>
                  <field name="agent_id" invisible="listed_by != 'agent'"/>
                  <field name="co_agent_ids" widget="many2many_tags" invisible="listed_by != 'agent'"/>
                  <field name="builder_id" invisible="listed_by != 'builder'"/>
                  <field name="sales_user_id" invisible="listed_by != 'salesperson'"/>
                </group>
                <group string="Brokerage">
                  <field name="brokerage_type"/>
                  <field name="brokerage_value"/>
                  <field name="brokerage_currency_id" invisible="brokerage_type != 'fixed'"/>
                </group>
              </group>
            </page>

            <page string="Amenities">
              <field name="amenity_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_estate_property_search" model="ir.ui.view">
    <field name="name">estate.property.search</field>
    <field name="model">estate.property</field>

    <field name="arch" type="xml">
      <search string="Properties">
        <!-- Quick fields -->
        <field name="name" string="Name / Ref"
               filter_domain="['|', ('name', 'ilike', self), ('ref', 'ilike', self)]"/>
        <field name="type_id"/>
        <separator/>

        <!-- Quick filters -->
        <filter name="my_props" string="My Properties"
                domain="['|', ('create_uid', '=', uid), ('sales_user_id', '=', uid)]"/>
        <filter name="sale" string="For Sale" domain="[('tenure', '=', 'sale')]"/>
        <filter name="rent" string="For Rent" domain="[('tenure', '=', 'rent')]"/>
        <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
        <separator/>

        <!-- Handy numeric shortcuts -->
        <filter name="br2" string="2+ BR" domain="[('bedrooms', '>=', 2)]"/>
        <filter name="br3" string="3+ BR" domain="[('bedrooms', '>=', 3)]"/>
        <filter name="bath2" string="2+ Bath" domain="[('bathrooms', '>=', 2)]"/>
        <separator/>

        <!-- Date filters -->
        <filter name="created" string="Created" date="create_date"/>
        <filter name="avail_from" string="Available From" date="availability_date"/>

        <field name="city_id" string="City"/>
        <field name="area_id" string="Area"/>

        <!-- Group By (v18 syntax) -->
        <group>
          <filter string="Type"        name="grp_type"     context="{'group_by': 'type_id'}"/>
          <filter string="Tenure"      name="grp_tenure"   context="{'group_by': 'tenure'}"/>
          <filter string="City"        name="grp_city"     context="{'group_by': 'city_id'}"/>
          <filter string="Area"        name="grp_city"     context="{'group_by': 'area_id'}"/>
          <filter string="State"       name="grp_state"    context="{'group_by': 'state_id'}"/>
          <filter string="Country"     name="grp_country"  context="{'group_by': 'country_id'}"/>
          <filter string="Salesperson" name="grp_sales"    context="{'group_by': 'sales_user_id'}"/>
          <filter string="Status"      name="grp_status"   context="{'group_by': 'state'}"/>
          <separator orientation="vertical"/>
          <filter string="Created Month"     name="grp_created_m" context="{'group_by': 'create_date:month'}"/>
          <filter string="Availability Month" name="grp_avail_m"  context="{'group_by': 'availability_date:month'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- KANBAN: compact card with image, key facts, quick chips -->
  <record id="view_estate_property_kanban" model="ir.ui.view">
  <field name="name">estate.property.kanban</field>
  <field name="model">estate.property</field>
  <field name="arch" type="xml">
    <kanban class="o_kanban_mobile" default_group_by="type_id">
      <!-- declare fields used in template -->
      <field name="image_1920"/>
      <field name="name"/>
      <field name="state"/>
      <field name="type_id"/>
      <field name="city"/>
      <field name="tenure"/>
      <field name="price"/>
      <field name="rent_price"/>
      <field name="currency_id"/>
      <field name="bedrooms"/>
      <field name="bathrooms"/>
      <field name="ref"/>
      <field name="priority"/>

      <templates>
        <t t-name="card">
          <div class="oe_kanban_global_click o_kanban_record">
            <!--<div class="o_kanban_image">
              <field name="image_1920" widget="image" class="o_kanban_image_fill"/>
            </div>-->

            <div class="o_kanban_details">
              <div class="o_kanban_primary d-flex justify-content-between align-items-center">
                <strong class="o_kanban_record_title">
                  <field name="name"/>
                </strong>
                <!-- Small image -->
                <div style="width: 40px; height: 40px; overflow: hidden; border-radius: 4px;">
                    <field name="image_1920" widget="image" class="o_kanban_image_thumb"/>
                </div>
              </div>

              <div class="text-muted small mt-1">
                <field name="type_id"/> • <field name="city"/>
              </div>

              <div class="mt-2 fw-semibold justify-content-between">
                <t t-if="record.tenure.raw_value == 'sale'">
                  <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </t>
                <t t-if="record.tenure.raw_value == 'rent'">
                  <field name="rent_price" widget="monetary" options="{'currency_field': 'currency_id'}"/> / month
                </t>
                <span t-attf-class="badge rounded-pill ms-2 #{record.state.raw_value == 'published' ? 'text-bg-success' : 'text-bg-secondary'}">
                  <field name="state"/>
                </span>
              </div>

              <div class="mt-2 d-flex gap-2 flex-wrap">
                <span class="badge bg-light text-dark border">
                  <i class="fa fa-home me-1"/> <field name="bedrooms"/> BR
                </span>
                <span class="badge bg-light text-dark border">
                  <i class="fa fa-bath me-1"/> <field name="bathrooms"/> Bath
                </span>
                <span class="badge bg-info-subtle text-info border">
                  <field name="tenure"/>
                </span>
              </div>
            </div>

            <div class="o_kanban_footer d-flex justify-content-between align-items-center mt-2">
              <span class="small text-muted">Ref: <field name="ref"/></span>
              <span class="small text-muted">Priority: <field name="priority"/></span>
            </div>
          </div>
        </t>
      </templates>
    </kanban>
  </field>
</record>


  <!-- PIVOT: slice/dice inventory & values -->
  <record id="view_estate_property_pivot" model="ir.ui.view">
    <field name="name">estate.property.pivot</field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
      <pivot string="Property Pivot">
        <!-- Measures -->
        <!--<field name="__count" type="measure" string="Count"/>-->
        <field name="price" type="measure" string="Sale Price (Sum)"/>
        <field name="rent_price" type="measure" string="Rent (Sum)"/>
        <field name="bedrooms" type="measure" string="Bedrooms (Avg)" operator="avg"/>
        <field name="bathrooms" type="measure" string="Bathrooms (Avg)" operator="avg"/>
        <!-- Dimensions -->
        <field name="type_id" type="row"/>
        <field name="city" type="row"/>
        <field name="tenure" type="col"/>
        <field name="state" type="col"/>
      </pivot>
    </field>
  </record>

  <!-- GRAPH: bar chart (stacked by Tenure), switchable measures -->
  <record id="view_estate_property_graph" model="ir.ui.view">
    <field name="name">estate.property.graph</field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
      <graph string="Property Analysis" type="bar" stacked="True">
        <!-- Default measure is Count; user can switch to price/rent in UI -->
        <field name="type_id" type="row"/>
        <field name="tenure" type="col"/>
        <!--<field name="__count" type="measure" string="Count"/>-->
        <field name="price" type="measure" string="Sale Price (Sum)"/>
        <field name="rent_price" type="measure" string="Rent (Sum)"/>
      </graph>
    </field>
  </record>

  <record id="action_estate_property" model="ir.actions.act_window">
    <field name="name">Properties</field>
    <field name="res_model">estate.property</field>
    <field name="view_mode">list,form,kanban,pivot,graph</field>
  </record>
    <menuitem id="menu_realestate_properties" name="Properties" parent="menu_realestate_root" action="action_estate_property" sequence="10"/>
</odoo>
