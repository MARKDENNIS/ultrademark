<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Amenity Category: tree/form -->
  <record id="view_estate_amenity_category_tree" model="ir.ui.view">
    <field name="name">estate.property.amenity.category.list</field>
    <field name="model">estate.property.amenity.category</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="icon"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_estate_amenity_category_form" model="ir.ui.view">
    <field name="name">estate.property.amenity.category.form</field>
    <field name="model">estate.property.amenity.category</field>
    <field name="arch" type="xml">
      <form string="Amenity Category">
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="icon"/>
            <field name="active"/>
          </group>
          <group>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_estate_amenity_category" model="ir.actions.act_window">
    <field name="name">Amenity Categories</field>
    <field name="res_model">estate.property.amenity.category</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Amenity: tree/form -->
  <record id="view_estate_amenity_tree" model="ir.ui.view">
    <field name="name">estate.property.amenity.list</field>
    <field name="model">estate.property.amenity</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="category_id"/>
        <field name="show_on_website"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_estate_amenity_form" model="ir.ui.view">
    <field name="name">estate.property.amenity.form</field>
    <field name="model">estate.property.amenity</field>
    <field name="arch" type="xml">
      <form string="Amenity">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="category_id"/>
              <field name="sequence"/>
              <field name="active"/>
              <field name="show_on_website"/>
            </group>
            <group>
              <field name="image_1920" widget="image" class="oe_avatar" options='{"preview_image": "avatar_128"}'/>
            </group>
          </group>
          <group>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_estate_amenity" model="ir.actions.act_window">
    <field name="name">Amenities</field>
    <field name="res_model">estate.property.amenity</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menus -->
  <menuitem id="menu_realestate_amenities_root" name="Amenities"
            parent="menu_realestate_config" sequence="30"/>

  <menuitem id="menu_realestate_amenity_categories"
            name="Categories"
            parent="menu_realestate_amenities_root"
            action="action_estate_amenity_category" sequence="10"/>
  <menuitem id="menu_realestate_amenities"
            name="Amenities"
            parent="menu_realestate_amenities_root"
            action="action_estate_amenity" sequence="20"/>
</odoo>
